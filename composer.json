{
    "name": "zana/console",
    "description": "Console command contracts and kernel for Zana applications",
    "type": "library",
    "keywords": ["zana", "console", "cli", "command"],
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Console\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

