{
    "name": "mj-zana/console",
    "description": "Console kernel on Symfony Console with a container scope per command for Zana applications",
    "type": "library",
    "keywords": [
        "zana",
        "console",
        "cli",
        "commands",
        "symfony-console"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/core": "^2.7",
        "symfony/console": "^7.4 || ^8.0"
    },
    "suggest": {
        "ext-zip": "Needed by release:build to write the upload archives",
        "mj-zana/testing": "Lets the check command run the modules' architecture rules",
        "mj-zana/validation": "To show the field errors of a ValidationException"
    },
    "require-dev": {
        "mj-zana/testing": "^2.6",
        "mj-zana/validation": "^2.10",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Console\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures.php"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "../zana-audit",
            "options": {
                "symlink": true,
                "versions": {
                    "mj-zana/audit": "2.10.0"
                }
            }
        },
        {
