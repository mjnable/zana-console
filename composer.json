{
    "name": "mj-zana/console",
    "description": "Console kernel on Symfony Console with a container scope per command for Zana applications",
    "type": "library",
    "keywords": ["zana", "console", "cli", "commands", "symfony-console"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/core": "^2.2",
        "symfony/console": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Console\\Tests\\": "tests/"
        },
        "files": ["tests/Fixtures.php"]
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.2.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.2.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.2.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
